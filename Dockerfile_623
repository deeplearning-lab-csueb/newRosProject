# =================== Duckietown 项目标准参数 ===================
ARG PROJECT_NAME="ROS"
ARG PROJECT_DESCRIPTION="R"
ARG PROJECT_MAINTAINER="haoranli (branson0419@gmail.com)"
ARG PROJECT_FORMAT_VERSION=4
ARG PROJECT_ICON="cube"
ARG ROS_DISTRO=noetic

# =================== 基础镜像参数（Duckietown） ===================
ARG ARCH=arm64v8
ARG DISTRO=daffy
ARG DOCKER_REGISTRY=docker.io
ARG BASE_IMAGE=masterhapero/dt-duckpack-yolov11
ARG BASE_ORGANIZATION=duckietown
ARG BASE_TAG=ente-arm64v8
ARG LAUNCHER=default
ARG BASE_REPOSITORY=dt-duckpack-yolov11

# =================== FROM Duckietown 镜像 ===================
FROM ${DOCKER_REGISTRY}/${BASE_IMAGE}:${BASE_TAG} as base

# 环境变量参数
ARG PROJECT_NAME
ARG PROJECT_DESCRIPTION
ARG PROJECT_MAINTAINER
ARG PROJECT_ICON
ARG PROJECT_FORMAT_VERSION
ARG ROS_DISTRO
ARG LAUNCHER
ARG BASE_REPOSITORY
ARG BASE_ORGANIZATION
ARG BASE_TAG

# ROS + Catkin 环境
ENV ROS_PYTHON_VERSION=3
ENV ROS_ROOT=/opt/ros/${ROS_DISTRO}
ENV ROS_DISTRO="${ROS_DISTRO}" \
    CATKIN_WS_DIR="/code"

# ========== 保证系统环境整洁，移除有问题的包 ==========
RUN apt-get update && \
    apt-get remove --purge -y python-opencv python3-opencv-apps python3-opencv-contrib \
    libboost-python1.65.1 libboost-python1.65.1-dev libboost-python-dev ros-noetic-cv-bridge && \
    pip3 uninstall -y opencv-python opencv-python-headless || true

# ========== 安装正确的、与Jetson适配的依赖（APT ONLY） ==========
RUN apt-get update && \
    apt-get install -y python3-opencv libopencv-dev libboost-python1.65.1 libboost-python-dev ros-${ROS_DISTRO}-cv-bridge

# ========== LD_LIBRARY_PATH 覆盖，保证so查找顺利 ==========
ENV LD_LIBRARY_PATH="/lib/aarch64-linux-gnu:/usr/lib/aarch64-linux-gnu:/opt/ros/${ROS_DISTRO}/lib:/code/devel/lib:${LD_LIBRARY_PATH}"

# ========== 项目相关路径参数 ==========
ARG PROJECT_PATH="/code"
ARG PROJECT_LAUNCHERS_PATH="/code/launchers"
WORKDIR "${PROJECT_PATH}"

ENV DT_PROJECT_NAME="${PROJECT_NAME}" \
    DT_PROJECT_DESCRIPTION="${PROJECT_DESCRIPTION}" \
    DT_PROJECT_MAINTAINER="${PROJECT_MAINTAINER}" \
    DT_PROJECT_ICON="${PROJECT_ICON}" \
    DT_PROJECT_PATH="${PROJECT_PATH}" \
    DT_PROJECT_LAUNCHERS_PATH="${PROJECT_LAUNCHERS_PATH}" \
    DT_LAUNCHER="${LAUNCHER}"

# ========== 安装 apt 依赖 ==========
COPY ./dependencies-apt.txt "${PROJECT_PATH}/"
RUN dt-apt-install ${PROJECT_PATH}/dependencies-apt.txt

# ========== 安装 python3 依赖 ==========
ARG PIP_INDEX_URL="https://pypi.org/simple"
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
COPY ./dependencies-py3.* "${PROJECT_PATH}/"
RUN dt-pip3-install "${PROJECT_PATH}/dependencies-py3.*"

# ========== 复制源码 ==========
COPY ./packages "${PROJECT_PATH}/packages"

# ========== 构建 catkin 工作空间 ==========
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
  catkin build --workspace ${CATKIN_WS_DIR}/

# ========== 安装 launcher 脚本 ==========
COPY ./launchers/. "${PROJECT_LAUNCHERS_PATH}/"
RUN dt-install-launchers "${PROJECT_LAUNCHERS_PATH}"

# ========== 复制 assets ==========
COPY ./assets/entrypoint.d "${PROJECT_PATH}/assets/entrypoint.d"
COPY ./assets/environment.d "${PROJECT_PATH}/assets/environment.d"

# ========== 默认命令 ==========
CMD ["bash", "-c", "dt-launcher-${DT_LAUNCHER}"]

# ========== 标准 Duckietown 镜像 LABEL ==========
LABEL \
    org.duckietown.label.project.name="${PROJECT_NAME}" \
    org.duckietown.label.project.description="${PROJECT_DESCRIPTION}" \
    org.duckietown.label.project.maintainer="${PROJECT_MAINTAINER}" \
    org.duckietown.label.project.icon="${PROJECT_ICON}" \
    org.duckietown.label.project.path="${PROJECT_PATH}" \
    org.duckietown.label.project.launchers.path="${PROJECT_LAUNCHERS_PATH}" \
    org.duckietown.label.format.version="${PROJECT_FORMAT_VERSION}" \
    org.duckietown.label.platform.os="linux" \
    org.duckietown.label.platform.architecture="arm64v8" \
    org.duckietown.label.code.distro="${DISTRO}" \
    org.duckietown.label.code.launcher="${LAUNCHER}" \
    org.duckietown.label.code.python.registry="${PIP_INDEX_URL}" \
    org.duckietown.label.base.organization="${BASE_ORGANIZATION}" \
    org.duckietown.label.base.repository="${BASE_REPOSITORY}" \
    org.duckietown.label.base.tag="${BASE_TAG}"
# <== Do not change the code above this line
# <==================================================

